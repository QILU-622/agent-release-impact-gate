# Real pilot exports may contain customer or operational information. Only the
# documentation and deliberately synthetic example files are public fixtures.
pilot/**
!pilot/README.md
!pilot/*.example.csv
!pilot/*.example.json

# Large row-level experiment artifacts are regenerated by the project. Compact
# manifests, aggregate tables, reports, figures, and release-gate demo outputs
# remain available for an inspectable public repository.
data/runs/
data/evaluation/feature_dataset.csv
data/workforce_twin/event_log.csv

# Default CLI scratch outputs are superseded by the executed demo packet.
outputs/release_gate/release_decision.json
outputs/release_gate/release_decision.md
outputs/release_gate/case_diffs.csv

# Superseded pre-v2 narratives conflict with the release-gate product scope.
outputs/reports/enterprise_adoption_playbook.md
outputs/reports/v0.9_completion_evidence.md

# Notebook scratch state
.ipynb_checkpoints/
